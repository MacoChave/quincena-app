{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug: dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "--dart-define=ENVIRONMENT=dev"
      ]
    },
    {
      "name": "build: dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build: dev",
      "args": [
        "--dart-define=ENVIRONMENT=dev"
      ]
    },
    {
      "name": "build: prod",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build: prod",
      "args": [
        "--dart-define=ENVIRONMENT=prod"
      ]
    },
    {
      "name": "quincena-mobile (run: release prod)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "--dart-define=ENVIRONMENT=prod"
      ]
    }
  ]
}
