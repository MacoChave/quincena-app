{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug: dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "quincena/lib/main.dart",
      "cwd": "${workspaceFolder}/quincena",
      "args": [
        "--dart-define=ENVIRONMENT=dev"
      ]
    },
    {
      "name": "build: dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "quincena/lib/main.dart",
      "cwd": "${workspaceFolder}/quincena",
      "preLaunchTask": "build: dev",
      "args": [
        "--dart-define=ENVIRONMENT=dev"
      ]
    },
    {
      "name": "build: prod",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "quincena/lib/main.dart",
      "cwd": "${workspaceFolder}/quincena",
      "preLaunchTask": "build: prod",
      "args": [
        "--dart-define=ENVIRONMENT=prod"
      ]
    },
    {
      "name": "quincena-mobile (run: release prod)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "quincena/lib/main.dart",
      "cwd": "${workspaceFolder}/quincena",
      "args": [
        "--dart-define=ENVIRONMENT=prod"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Quincena API (NestJS)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "autoAttachChildProcesses": true,
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/quincena-api"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach: Debugger (Port 9229)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/quincena-api"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (API Debug + Mobile Debug Dev)",
      "configurations": [
        "Debug: Quincena API (NestJS)",
        "debug: dev"
      ]
    }
  ]
}
