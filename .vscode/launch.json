{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug: dev (USB - Recomendado)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/quincena",
      "program": "${workspaceFolder}/quincena/lib/main.dart",
      "preLaunchTask": "adb: reverse port 3000",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--dart-define=API_BASE_URL=http://127.0.0.1:3000/v1"
      ]
    },
    {
      "name": "debug: dev (Wi-Fi 192.168.10.116)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/quincena",
      "program": "${workspaceFolder}/quincena/lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--dart-define=API_BASE_URL=http://192.168.10.116:3000/v1"
      ]
    },
    {
      "name": "debug: dev (Emulador Android)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/quincena",
      "program": "${workspaceFolder}/quincena/lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--dart-define=API_BASE_URL=http://10.0.2.2:3000/v1"
      ]
    },
    {
      "name": "debug: dev (API Render en la Nube)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/quincena",
      "program": "${workspaceFolder}/quincena/lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--dart-define=API_BASE_URL=https://quincena-app.onrender.com/v1"
      ]
    },
    {
      "name": "build: dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/quincena",
      "program": "${workspaceFolder}/quincena/lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--dart-define=API_BASE_URL=http://127.0.0.1:3000/v1"
      ]
    },
    {
      "name": "build: prod",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "cwd": "${workspaceFolder}/quincena",
      "program": "${workspaceFolder}/quincena/lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=prod",
        "--dart-define=API_BASE_URL=https://quincena-app.onrender.com/v1"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Quincena API (NestJS)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "autoAttachChildProcesses": true,
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/quincena-api"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach: Debugger (Port 9229)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/quincena-api"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (API + Mobile USB Dev)",
      "configurations": [
        "Debug: Quincena API (NestJS)",
        "debug: dev (USB - Recomendado)"
      ]
    }
  ]
}
