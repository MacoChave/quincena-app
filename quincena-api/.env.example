# ============================================================
# Quincena API — Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Puerto del servidor (default: 3000)
PORT=3000

# Entorno de ejecución (development / production / test)
NODE_ENV=development

# ---- Supabase ----
# URL de tu proyecto Supabase (ej. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Llave pública de Supabase
# Nueva nomenclatura en dashboard: SUPABASE_PUBLISHABLE_KEY
# Nomenclatura previa soportada: SUPABASE_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Llave secreta / de servicio de Supabase con privilegios backend (¡NUNCA exponer en cliente!)
# Nueva nomenclatura en dashboard: SUPABASE_SECRET_KEY
# Nomenclatura previa soportada: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# (Opcional) URL JWKS para validación de tokens / firmas JWT modernas
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# (Opcional / Legacy) Secret JWT clásico si se usa firma simétrica HMAC
SUPABASE_JWT_SECRET=your-jwt-secret
